environment = "cidev"
aws_profile = "development-eu-west-2"

use_set_environment_files = true

# Scheduled scaling of tasks
service_autoscale_enabled  = true
service_scaledown_schedule = "55 19 * * ? *"
service_scaleup_schedule   = "5 6 * * ? *"

required_cpus = 512
required_memory = 1024
service_autoscale_scale_out_cooldown = 600

# Enable Parallel Old Kafka Service
create_old_kafka_service = true
alphabetical_company_search_consumer_old_kafka_version = "0.1.26"

# Enable Parallel Green Alphabetical Company Search Consumer Service for OpenSearch backend
create_green_alphabetical_company_search_consumer_service = true
green_alphabetical_company_search_consumer_version = "0.1.27"
